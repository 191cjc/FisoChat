# QQ 开放平台的机器人凭据。
QQ_BOT_APPID=
QQ_BOT_SECRET=

# 新项目默认使用独立数据库和端口。
FISOCHAT_DB=data/group_messages.db
FISOCHAT_WEB_HOST=127.0.0.1
FISOCHAT_WEB_PORT=8789

# 交互终端和命令行发送所需的管理 Token。
FISOCHAT_ADMIN_TOKEN=
# 或指定仅当前用户可读写（0600）的 Token 文件。
FISOCHAT_ADMIN_TOKEN_FILE=

# 全局表情库与 QQ 临时取图地址。两个密钥请分别生成并妥善保管。
FISOCHAT_STICKER_DIR=data/stickers
FISOCHAT_STICKER_PUBLIC_BASE_URL=https://example.com/fisochat
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FISOCHAT_STICKER_SIGNING_SECRET=

FISOCHAT_HTTP_TIMEOUT_SECONDS=30
FISOCHAT_GATEWAY_RESTART_TIMEOUT_SECONDS=90
FISOCHAT_LOG_LEVEL=INFO
